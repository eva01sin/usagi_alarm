<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_motion" android:layout_width="match_parent" android:layout_height="match_parent"
    android:autoStart="true" android:flipInterval="1000" android:importantForAccessibility="noHideDescendants">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/usagi_tilt_left" android:scaleType="fitCenter" android:padding="2dp"
        android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/usagi_icon" android:scaleType="fitCenter" android:padding="2dp"
        android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/usagi_tilt_right" android:scaleType="fitCenter" android:padding="2dp"
        android:contentDescription="@null" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/usagi_icon" android:scaleType="fitCenter" android:padding="2dp"
        android:contentDescription="@null" android:importantForAccessibility="no" />
</ViewFlipper>
